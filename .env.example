# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (VAPID key pair; subject is a mailto: address)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Golf Town portal (/golftown): shared login for the Golf Town rep
GOLFTOWN_PORTAL_USER=
GOLFTOWN_PORTAL_PASSWORD=
# Random long string used to sign the portal session cookie
GOLFTOWN_PORTAL_SECRET=

# Order notification emails (Resend HTTP API; domain must be verified in Resend)
RESEND_API_KEY=
# Where new-order notifications are sent
ORDER_NOTIFY_EMAIL=
# From address; must be at the Resend-verified domain. Optional — defaults
# to BGBCamp <orders@updates.customgolfballprinting.com>
ORDER_FROM_EMAIL=

# Public base URL of the deployed app, used in email links
NEXT_PUBLIC_APP_URL=
# Ready-for-pickup email recipient (Matt); defaults to hello@customgolfballprinting.com
GOLFTOWN_PICKUP_EMAIL=
# Golf Town's email (Matt) for confirmations + ready-for-pickup notices;
# defaults to hello@customgolfballprinting.com while testing
GOLFTOWN_EMAIL=
